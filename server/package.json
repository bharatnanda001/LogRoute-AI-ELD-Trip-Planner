{
  "name": "eld-trip-planner-server",
  "version": "1.0.0",
  "description": "ELD Trip Planner — backend REST API with HOS engine",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "set NODE_OPTIONS=--experimental-vm-modules && npx jest --forceExit",
    "test:watch": "set NODE_OPTIONS=--experimental-vm-modules && npx jest --watch",
    "db:init": "psql -f schema/database-schema.sql",
    "db:seed": "psql -f schema/seed.sql"
  },
  "keywords": [
    "eld",
    "hos",
    "fmcsa",
    "trip-planner"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "transform": {},
    "extensionsToTreatAsEsm": []
  }
}
