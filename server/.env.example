# ── Server ──────────────────────────────────────────────
PORT=3001

# ── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eld_trip_planner

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

# ── Routing API ─────────────────────────────────────────
# OpenRouteService (primary) — get free key at https://openrouteservice.org
ORS_API_KEY=
# Falls back to OSRM demo server if ORS_API_KEY is blank
